#!/usr/bin/env bash
#MISE description="Edit a secret of fnox in your editor, then apply the dotfiles"
#MISE raw=true
#USAGE arg "<name>" help="The name of the secret, for example WORKRC"
#USAGE flag "-p --profile <profile>" help="The profile of the secret, for example doctolib"
#
# fnox edit (1.43.0) opens all the secrets of all the profiles, and it runs $EDITOR without its
# arguments, so "code --wait" fails before fnox 1.44.0. This task opens only one value.
# This task writes the value into a private temporary file and opens it in $EDITOR. Then it
# encrypts the new value with fnox set --from-file, removes the file, and runs mise dot apply.
# fnox set keeps the other settings of the secret (env, description).
#   mise run edit-secret --profile doctolib WORKRC

set -eufo pipefail

# lib/ is at the root of this repository: follow the link of this task to find it.
source "$(dirname "$(readlink -f "$0")")/../../../lib/logs.sh"

name="${usage_name:?}"
profile=()
if [ -n "${usage_profile:-}" ]; then
  profile=(--profile "$usage_profile")
fi

umask 077
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT

fnox get ${profile[@]+"${profile[@]}"} "$name" > "$dir/value"
# fnox get adds a newline after the value: remove it, so that the value stays the same.
perl -i -pe 'chomp if eof' "$dir/value"
cp "$dir/value" "$dir/before"

# $EDITOR can have arguments, for example "code --wait": the shell splits them.
sh -c "${EDITOR:-vi} \"\$1\"" sh "$dir/value"

if cmp -s "$dir/value" "$dir/before"; then
  log_task "$name did not change"
  exit 0
fi
fnox set "$name" --global ${profile[@]+"${profile[@]}"} --provider age --from-file "$dir/value" >/dev/null
log_done "$name encrypted again"
mise dot apply --yes
