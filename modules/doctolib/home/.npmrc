{#- ~/.npmrc: the npm registry of Doctolib, for the role work. The content is the secret NPMRC of fnox
    (profile doctolib), encrypted in the global config of fnox. Edit it with:
      mise run edit-secret --profile doctolib NPMRC
    Until fnox, its provider (age.toml) and the age key exist, the template renders empty, and mise
    does not write the file (remove_empty): the next run of mise bootstrap writes it. -#}
{%- if exec(command="command -v fnox >/dev/null && test -s ~/.config/fnox/age.toml && test -s ~/.ssh/encryption_ed25519 && echo ready || true") == "ready" -%}
{{ exec(command="fnox get --profile doctolib NPMRC") }}
{%- endif -%}
