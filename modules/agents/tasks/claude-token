#!/usr/bin/env bash
#MISE description="Create the Claude token of the VS Code Agents window"
#MISE raw=true
#
# Create the Claude subscription token of the VS Code Agents window (native mode, no Copilot).
# The token stays in the macOS Keychain: this public repository holds no secret, and ~/.zshrc
# exports it only while VS Code reads the shell environment.
# mise bootstrap runs this task each time (task bootstrap). The task only checks the Keychain
# when the token exists. When the token expired, delete the Keychain entry and run the task again:
#   security delete-generic-password -a "$USER" -s claude-code-oauth-token
#   mise run claude-token
# `claude setup-token` has no machine-readable output, so you paste the token yourself.

set -eufo pipefail

# lib/ is at the root of this repository: follow the link of this task to find it.
source "$(dirname "$(readlink -f "$0")")/../../../lib/logs.sh"

service="claude-code-oauth-token"

command -v claude >/dev/null 2>&1 || exit 0
security find-generic-password -a "$USER" -s "$service" >/dev/null 2>&1 && exit 0

if [ ! -t 0 ]; then
  log_task "No Claude token in the Keychain: run mise run claude-token in a terminal to create it"
  exit 0
fi

read -r -p "Create the Claude token of the VS Code Agents window now? [y/N] " answer
case "$answer" in
  [yY]*) ;;
  *) log_task "Claude token skipped: mise bootstrap asks again at the next run"; exit 0 ;;
esac

log_task "Creating a Claude token: log in with your browser, then copy the token..."
env -u CLAUDE_CODE_OAUTH_TOKEN claude setup-token

log_task "Paste the token (twice). The terminal does not show it."
security add-generic-password -a "$USER" -s "$service" -U -w
log_done "Claude token stored in the Keychain: restart VS Code from the Dock"
