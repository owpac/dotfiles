{#- The public key of the 1Password SSH agent. The NAS has no 1Password: the key is in the file.
    Without the CLI of 1Password (op), the template renders empty, and mise does not write the
    file (remove_empty): the next run of mise bootstrap writes it. -#}
{%- if "server" in (mise_env | default(value=[])) -%}
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDiSTJlYGdxl8weXWkGZupNEsHeSthnh63m2DeBXXcm8
{%- elif exec(command="command -v op || true") -%}
{{ exec(command="op read 'op://Personal/mbp_ed25519/public key'") }}
{%- endif -%}
