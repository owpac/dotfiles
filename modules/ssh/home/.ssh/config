{%- set envs = mise_env | default(value=[]) -%}
{%- if os() == "macos" -%}
Include {{ env.HOME }}/.colima/ssh_config

# Use 1Password SSH agent
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

{% endif -%}
{%- if "server" in envs -%}
# Headless mode - use local public keys with forwarded agent
Host *
  IdentitiesOnly yes

{% endif -%}
Host github.com
  IdentityFile ~/.ssh/mbp_ed25519.pub
  IdentitiesOnly yes

# Alias of github.com for the private tools of owpac that mise installs (roles server and
# workstation). For a source on github.com, mise calls the GitHub API, and this API
# needs a token for a private repository. For another host name, mise runs `git ls-remote`, so SSH
# and the 1Password agent give the access.
Host owpac
  HostName github.com
  IdentityFile ~/.ssh/mbp_ed25519.pub
  IdentitiesOnly yes

Host nas
  HostName 10.0.0.10
  User thomas
  IdentityFile ~/.ssh/mbp_ed25519.pub
  IdentitiesOnly yes
  ForwardAgent yes

Host rpi
  HostName 10.0.0.12
  User thomas
  IdentityFile ~/.ssh/mbp_ed25519.pub
  IdentitiesOnly yes
  ForwardAgent yes

{% if "work" in envs -%}
Host doctolib
  HostName github.com
  IdentityFile ~/.ssh/doctolib_ed25519.pub
  IdentitiesOnly yes
{%- endif %}
