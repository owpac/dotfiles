#!/usr/bin/env bash
# Reinstalls kompose via pipx (editable mode) whenever pyproject.toml changes.
# The companion `regen-kompose-completion` script handles the lighter zsh
# completion refresh on its own (CLI surface) hash, so we don't burn a
# full pipx reinstall every time __main__.py changes.
# Hash: {{ include (joinPath .chezmoi.workingTree "packages/kompose/pyproject.toml") | sha256sum }}

set -eufo pipefail

source {{ .chezmoi.workingTree }}/lib/logs.sh

PACKAGE_DIR="{{ .chezmoi.workingTree }}/packages/kompose"

if ! command -v pipx >/dev/null 2>&1; then
    log_error "pipx not found — install it first (brew install pipx, or python3 -m pip install --user pipx)"
    exit 1
fi

log_task "Installing kompose via pipx (editable mode)..."
pipx install --editable "$PACKAGE_DIR" --force >/dev/null
log_done "kompose installed: $(command -v kompose)"
