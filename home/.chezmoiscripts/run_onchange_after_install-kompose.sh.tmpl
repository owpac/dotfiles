#!/usr/bin/env bash
# Reinstalls kompose via pipx (editable mode) and regenerates the zsh
# completion. Re-runs whenever either the deps (pyproject.toml) or the CLI
# surface (__main__.py) changes.
# Hash: {{ include (joinPath .chezmoi.workingTree "packages/kompose/pyproject.toml") | sha256sum }}{{ include (joinPath .chezmoi.workingTree "packages/kompose/src/kompose/__main__.py") | sha256sum }}

set -eufo pipefail

source {{ .chezmoi.workingTree }}/lib/logs.sh

PACKAGE_DIR="{{ .chezmoi.workingTree }}/packages/kompose"
COMPLETION_FILE="${HOME}/.local/bin/completions/_kompose"

if ! command -v pipx >/dev/null 2>&1; then
    log_error "pipx not found — install it first (brew install pipx, or python3 -m pip install --user pipx)"
    exit 1
fi

log_task "Installing kompose via pipx (editable mode)..."
pipx install --editable "$PACKAGE_DIR" --force >/dev/null
log_done "kompose installed: $(command -v kompose)"

log_task "Regenerating zsh completion → $COMPLETION_FILE"
mkdir -p "$(dirname "$COMPLETION_FILE")"
kompose --completion zsh > "$COMPLETION_FILE"
log_done "completion regenerated ($(awk 'END{print NR}' "$COMPLETION_FILE") lines)"
