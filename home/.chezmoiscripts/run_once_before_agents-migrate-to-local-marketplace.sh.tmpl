{{- if and (not .is_minimum) (not .is_headless) -}}
#!/usr/bin/env bash

# One-time migration (2026-10): the plugins, the MCP servers and the Beads hooks of the agents
# come from the runtime clone ~/.local/share/agent-marketplaces/owpac (see the modify
# templates of ~/.claude/settings.json and ~/.codex/config.toml).
# Runs before chezmoi writes the agent config files, because the commands below also edit
# these files. chezmoi then writes the new declarations in the same apply.
#   - The marketplace owpac moves from GitHub (Claude Code) and git (Codex) to the runtime
#     clone. A new source in settings.json is not enough: Claude Code then stops loading the
#     plugins. So remove the old marketplace and its plugin copies first.
#   - The MCP servers move to plugins: engram@owpac, and for Atlassian the official plugin
#     atlassian@claude-plugins-official (enable it by hand, chezmoi does not manage it). GitHub
#     goes through gh and git. Remove the old servers of the Claude Code user scope and of the
#     Codex config.
#   - The Beads hooks move to the plugin beads@owpac. Remove the old handlers: a command that
#     starts with "bd " or that runs a script of ~/.config/ia/hooks.

set -uo pipefail

source {{ .chezmoi.workingTree }}/lib/logs.sh

remove_beads_hooks() {
  [ -f "$1" ] || return 0
  jq '.hooks |= ((. // {})
      | map_values([.[] | .hooks |= map(select((.command // "") | test("^bd |/\\.config/ia/hooks/") | not)) | select(.hooks | length > 0)])
      | with_entries(select(.value | length > 0)))' "$1" > "$1.new" || { rm -f "$1.new"; return 0; }
  if [ "$(jq -cS . "$1")" = "$(jq -cS . "$1.new")" ]; then rm -f "$1.new"; return 0; fi
  mv "$1.new" "$1" && log_done "Old Beads hooks removed from $1"
}
remove_beads_hooks "$HOME/.claude/settings.json"
remove_beads_hooks "$HOME/.codex/hooks.json"
rm -f "$HOME/.config/ia/hooks/link-bd-session" && rmdir "$HOME/.config/ia/hooks" 2>/dev/null || true

if command -v claude >/dev/null 2>&1; then
  if jq -e '.owpac and .owpac.source.source != "directory"' "$HOME/.claude/plugins/known_marketplaces.json" >/dev/null 2>&1; then
    log_task "Removing the GitHub marketplace owpac from Claude Code..."
    claude plugin marketplace remove owpac >/dev/null && log_done "Marketplace owpac removed from Claude Code"
  fi
  for server in engram github atlassian; do
    jq -e --arg s "$server" '.mcpServers[$s]' "$HOME/.claude.json" >/dev/null 2>&1 || continue
    claude mcp remove --scope user "$server" >/dev/null && log_done "MCP server $server removed from the Claude Code user scope"
  done
fi

codex=$(command -v codex || ls -d "$HOME"/.vscode/extensions/openai.chatgpt-*/bin/*/codex 2>/dev/null | tail -1 || true)
if [ -n "$codex" ]; then
  if "$codex" plugin list --json 2>/dev/null | jq -e '.installed[]? | select(.marketplaceName == "owpac" and .marketplaceSource.sourceType != "local")' >/dev/null; then
    log_task "Removing the git marketplace owpac from Codex..."
    for id in $("$codex" plugin list --json 2>/dev/null | jq -r '.installed[]? | select(.marketplaceName == "owpac") | .pluginId'); do
      "$codex" plugin remove "$id" >/dev/null || log_error "Could not remove $id from Codex"
    done
    "$codex" plugin marketplace remove owpac >/dev/null && log_done "Marketplace owpac removed from Codex"
  fi
  # Check config.toml itself: `codex mcp get engram` also finds the server of the plugin engram.
  if grep -Eq '^[[:space:]]*\[mcp_servers\.engram\]' "$HOME/.codex/config.toml" 2>/dev/null; then
    "$codex" mcp remove engram >/dev/null && log_done "MCP server engram removed from the Codex config"
  fi
fi
{{ end -}}
