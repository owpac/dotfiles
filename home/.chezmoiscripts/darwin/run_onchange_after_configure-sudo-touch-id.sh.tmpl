{{ if and (eq .chezmoi.os "darwin") (not .is_minimum) -}}
{{- $module := "/opt/homebrew/lib/pam/pam_reattach.so" -}}
{{- $reattach := stat $module -}}
#!/usr/bin/env bash

# Touch ID for sudo, in /etc/pam.d/sudo_local. Since macOS 14, /etc/pam.d/sudo includes this
# file, and macOS updates keep it (they replace /etc/pam.d/sudo). chezmoi manages only the
# home folder, so this script writes the file with sudo. Same content and permissions as
# `mo touchid` (mole): owner root:wheel, mode 444.
# The script compares the files first, so it asks for sudo only when a file changes.
#
# pam_reattach (Homebrew package pam-reattach) puts sudo back into the GUI session, so Touch
# ID also works in a terminal multiplexer such as herdr or tmux. The Homebrew files belong to
# the user, so a program of the user could replace the module, and sudo would then load it as
# root. So the script installs a copy that belongs to root, and sudo_local loads this copy.
# Without the Homebrew package, sudo_local loads pam_tid only, and the script removes the root
# copy after sudo_local no longer loads it. To uninstall pam-reattach: remove it from the
# Homebrew list, run `brew uninstall pam-reattach`, then `chezmoi apply`.
{{- if $reattach }}
# Hash of the Homebrew module, so that an update of pam-reattach runs this script again:
# {{ include $module | sha256sum }}
{{- end }}

set -eufo pipefail

source {{ .chezmoi.workingTree }}/lib/logs.sh

if ! grep -q "sudo_local" /etc/pam.d/sudo; then
  log_error "/etc/pam.d/sudo does not include sudo_local (macOS 14 or later needed): Touch ID for sudo skipped"
  exit 0
fi

file=/etc/pam.d/sudo_local
wanted='# sudo_local: local customizations for sudo'
{{- if $reattach }}
module={{ $module | quote }}
copy=/usr/local/lib/pam/pam_reattach.so
wanted+=$'\n'"auth       optional       $copy ignore_ssh"

# Install the root copy first: sudo_local must not load a module that does not exist.
if ! cmp -s "$module" "$copy"; then
  log_task "Installing a root copy of pam_reattach in $copy..."
  sudo install -d -m 755 -o root -g wheel "$(dirname "$copy")"
  sudo install -m 444 -o root -g wheel "$module" "$copy"
fi
{{- end }}
wanted+=$'\n''auth       sufficient     pam_tid.so'

if [ "$(cat "$file" 2>/dev/null || true)" != "$wanted" ]; then
  log_task "Enabling Touch ID for sudo in $file..."
  tmp=$(mktemp)
  printf '%s\n' "$wanted" > "$tmp"
  sudo install -m 444 -o root -g wheel "$tmp" "$file"
  rm -f "$tmp"
  log_done "Touch ID enabled for sudo"
fi
{{- if not $reattach }}

# pam-reattach is not installed: remove the root copy, now that sudo_local does not load it.
copy=/usr/local/lib/pam/pam_reattach.so
if [ -e "$copy" ]; then
  sudo rm -f "$copy"
  sudo rmdir "$(dirname "$copy")" 2>/dev/null || true
  log_done "Root copy of pam_reattach removed"
fi
{{- end }}
{{ end -}}
