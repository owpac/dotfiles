{{ if and (eq .chezmoi.os "darwin") (not .is_minimum) -}}
#!/usr/bin/env bash

set -eufo pipefail

source {{ .chezmoi.workingTree }}/lib/logs.sh

# Re-apply macOS app preferences from the tracked snapshots in
# ~/.config/macos-preferences/ via `defaults import` (goes through cfprefsd, unlike
# editing the live plist directly). Instead of tracking the churny live
# ~/Library/Preferences/<domain>.plist, we track a stable encrypted snapshot per domain
# (.chezmoidata/macos-preferences.yaml → macos_preferences_domains) and re-import it.
#
# chezmoi re-runs this script when the *decrypted* content of a snapshot changes: the
# hashes below are in the script, so age re-encryption alone does not re-run it.
# The script then imports only the snapshots that changed since their last import.
# ~/.local/state/macos-preferences/<domain>.sha256 keeps the hash of the last import.
# So a new snapshot of one app does not reset the other apps, and a change to this script
# imports nothing. On a new machine, the script imports every snapshot.

state="$HOME/.local/state/macos-preferences"
mkdir -p "$state"

import() {
  local domain=$1 hash=$2
  [ "$(cat "$state/$domain.sha256" 2>/dev/null || true)" = "$hash" ] && return 0
  defaults import "$domain" "$HOME/.config/macos-preferences/$domain.plist"
  echo "$hash" > "$state/$domain.sha256"
  log_done "$domain preferences imported (restart the app to pick up the changes)"
}

{{ range .macos_preferences_domains -}}
import "{{ . }}" "{{ include (printf "dot_config/macos-preferences/encrypted_%s.plist.age" .) | decrypt | sha256sum }}"
{{ end -}}

# Capture a change after editing an app's settings:  pac preferences save [name...]
# Add a new app:  pac preferences save <domain>. pac also adds <domain> to
# .chezmoidata/macos-preferences.yaml, so that every machine re-applies it.
{{ end -}}
