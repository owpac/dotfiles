{{ if and (eq .chezmoi.os "darwin") (not .is_minimum) -}}
#!/usr/bin/env bash

set -eufo pipefail

source {{ .chezmoi.workingTree }}/lib/logs.sh

# Installs the herdr plugins. install-packages installs herdr before this script.
# herdr writes its plugin files itself: ~/.config/herdr/plugins.json and ~/.config/herdr/plugins/
# (git checkout, compiled binary, locks, absolute paths). Thus chezmoi does not manage these
# files. It manages only this list, and runs this script again when the list changes.
# A plugin that is already installed keeps its version. `herdr plugin update` updates it.

# <plugin id> <GitHub owner/repo> <git ref>
plugins=(
    "herdr-bar jeffarese/herdr-bar c49cc31cc62e0be18e79637262a572b5dd97f28a" # prefix+p (cmd+p)
)

installed=$(herdr plugin list)
for plugin in "${plugins[@]}"; do
    read -r id repo ref <<< "$plugin"
    if grep -q "^- $id " <<< "$installed"; then
        log_done "herdr plugin $id is already installed"
        continue
    fi
    log_task "Installing the herdr plugin $id..."
    herdr plugin install "$repo" --ref "$ref" --yes
    log_done "herdr plugin $id installed"
done
{{ end -}}
