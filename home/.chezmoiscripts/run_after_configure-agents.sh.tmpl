{{- if and (not .is_minimum) (not .is_headless) -}}
#!/usr/bin/env bash

# Configure the coding agents (see ~/.config/ia/AGENTS.md):
#   - Claude Code: engram MCP server (user scope), owpac marketplace and plugins;
#   - Codex: owpac marketplace and plugins (Codex reads Claude-format marketplaces);
#   - Beads: the home workspace, for tasks outside any repository (pac agent init --home).
# Both CLIs record these in their own state and settings files, so chezmoi runs the CLIs
# instead of managing those files. Runs on every apply and is idempotent: it catches up as
# soon as a tool gets installed, and skips a tool that is missing.
# Plugins: refreshes the owpac marketplace, updates each installed owpac plugin whose version
# changed in the marketplace (bump `version` in its plugin.json to ship a change), then
# installs the missing ones of `plugins`. A restart of the agent loads an updated plugin.

set -eufo pipefail

source {{ .chezmoi.workingTree }}/lib/logs.sh

marketplace="owpac/prompts" # private repository: fetching it needs GitHub credentials
plugins=(productivity rails setup beads) # same set for Claude Code and Codex; nas stays opt-in

# --- Claude Code ------------------------------------------------------------------------
if command -v claude >/dev/null 2>&1; then
  if command -v engram >/dev/null 2>&1 && ! claude mcp get engram >/dev/null 2>&1; then
    log_task "Registering the engram MCP server for Claude Code..."
    claude mcp add --scope user engram -- engram mcp --tools=agent >/dev/null
    log_done "engram MCP server registered for Claude Code"
  fi

  if ! claude plugin marketplace list --json 2>/dev/null | jq -e 'any(.[]; .name == "owpac")' >/dev/null; then
    log_task "Adding the owpac marketplace to Claude Code..."
    claude plugin marketplace add "$marketplace" >/dev/null
  fi

  # Claude Code does not refresh a third-party marketplace on its own. The versions are
  # compared first: `claude plugin update` takes a few seconds for each plugin.
  claude plugin marketplace update owpac >/dev/null 2>&1 || true
  root=$(claude plugin marketplace list --json 2>/dev/null | jq -r '.[] | select(.name == "owpac") | .installLocation' || true)
  installed=$(claude plugin list --json 2>/dev/null | jq -r '.[] | select(.id | endswith("@owpac")) | "\(.id | rtrimstr("@owpac")) \(.version)"' || true)

  while read -r p version; do
    [ -n "$p" ] || continue
    src=$(jq -r --arg p "$p" '.plugins[] | select(.name == $p) | .source' "$root/.claude-plugin/marketplace.json" 2>/dev/null || true)
    latest=$(jq -r '.version // empty' "$root/$src/.claude-plugin/plugin.json" 2>/dev/null || true)
    if [ -n "$latest" ] && [ "$latest" != "$version" ]; then
      log_task "Updating Claude Code plugin $p@owpac ($version -> $latest)..."
      if claude plugin update "$p@owpac" >/dev/null; then
        log_done "$p@owpac updated: restart Claude Code to load it"
      else
        log_error "Could not update $p@owpac in Claude Code"
      fi
    fi
  done <<<"$installed"

  for p in "${plugins[@]}"; do
    grep -q "^$p " <<<"$installed" && continue
    log_task "Installing Claude Code plugin $p@owpac..."
    claude plugin install "$p@owpac" >/dev/null || log_error "Could not install $p@owpac in Claude Code"
  done
fi

# --- Codex (CLI on PATH, otherwise the one bundled with the VS Code extension) ----------
set +f # the extension path needs globbing
codex=$(command -v codex || ls -d "$HOME"/.vscode/extensions/openai.chatgpt-*/bin/*/codex 2>/dev/null | tail -1 || true)
set -f

if [ -n "$codex" ]; then
  if ! "$codex" plugin marketplace list 2>/dev/null | awk 'NR > 1 {print $1}' | grep -qx owpac; then
    log_task "Adding the owpac marketplace to Codex..."
    "$codex" plugin marketplace add "$marketplace" >/dev/null
  fi

  # Same logic as Claude Code. Codex has no update command: `plugin add` on an installed
  # plugin installs the marketplace version and removes the old one from the cache.
  "$codex" plugin marketplace upgrade owpac >/dev/null 2>&1 || true
  installed=$("$codex" plugin list --marketplace owpac --json 2>/dev/null | jq -r '.installed[]? | "\(.name) \(.version) \(.source.path)"' || true)

  while read -r p version dir; do
    [ -n "$p" ] || continue
    latest=$(jq -r '.version // empty' "$dir/.claude-plugin/plugin.json" 2>/dev/null || true)
    if [ -n "$latest" ] && [ "$latest" != "$version" ]; then
      log_task "Updating Codex plugin $p@owpac ($version -> $latest)..."
      if "$codex" plugin add "$p@owpac" >/dev/null; then
        log_done "$p@owpac updated: restart Codex to load it"
      else
        log_error "Could not update $p@owpac in Codex"
      fi
    fi
  done <<<"$installed"

  for p in "${plugins[@]}"; do
    grep -q "^$p " <<<"$installed" && continue
    log_task "Installing Codex plugin $p@owpac..."
    "$codex" plugin add "$p@owpac" >/dev/null || log_error "Could not install $p@owpac in Codex"
  done
fi

# --- Beads home workspace ---------------------------------------------------------------
if command -v bd >/dev/null 2>&1 && [ -x "$HOME/.local/bin/pac" ] && [ ! -f "$HOME/.local/share/beads-home/.beads/metadata.json" ]; then
  "$HOME/.local/bin/pac" agent init --home || log_error "Could not create the Beads home workspace"
fi
{{ end -}}
