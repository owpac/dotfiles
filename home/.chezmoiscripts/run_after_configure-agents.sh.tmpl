{{- if and (not .is_minimum) (not .is_headless) -}}
#!/usr/bin/env bash

# Install what the agents do not install themselves:
#   - Codex: copy the plugins of owpac that ~/.codex/config.toml enables into the cache of
#     Codex, and remove the copies of the other plugins of owpac. Codex does not read a local
#     marketplace in place. Claude Code does, so it needs nothing here. `pac upgrade agents`
#     refreshes these copies after a pull.
#   - Beads: the home workspace, which holds every task (pac agent init).
# Runs on every apply and is idempotent: it catches up as soon as a tool gets installed, and
# skips a tool that is missing.

set -eufo pipefail

source {{ .chezmoi.workingTree }}/lib/logs.sh

# --- Codex (CLI on PATH only) ------------------------------------------------------------
if command -v codex >/dev/null 2>&1; then
  # The plugins of owpac that config.toml enables ([plugins."<plugin>@owpac"] enabled = true).
  enabled=$(awk '
    /^[[:space:]]*\[plugins\."[^"]+@owpac"\]/ { id = $0; sub(/^[[:space:]]*\[plugins\."/, "", id); sub(/"\].*$/, "", id); next }
    /^[[:space:]]*\[/ { id = "" }
    id != "" && /^[[:space:]]*enabled[[:space:]]*=[[:space:]]*true/ { print id }
  ' "$HOME/.codex/config.toml")
  installed=$(codex plugin list --json 2>/dev/null | jq -r '.installed[]? | select(.marketplaceName == "owpac") | .pluginId' || true)

  for id in $enabled; do
    grep -Fqx "$id" <<<"$installed" && continue
    log_task "Installing Codex plugin $id..."
    codex plugin add "$id" >/dev/null || log_error "Could not install $id in Codex"
  done

  for id in $installed; do
    grep -Fqx "$id" <<<"$enabled" && continue
    log_task "Removing Codex plugin $id, which config.toml no longer enables..."
    codex plugin remove "$id" >/dev/null || log_error "Could not remove $id from Codex"
  done
fi

# --- Beads home workspace ---------------------------------------------------------------
if command -v bd >/dev/null 2>&1 && [ -x "$HOME/.local/bin/pac" ] && [ ! -f {{ joinPath .chezmoi.homeDir .agents.beads_dir "metadata.json" | quote }} ]; then
  "$HOME/.local/bin/pac" agent init || log_error "Could not create the Beads home workspace"
fi
{{ end -}}
