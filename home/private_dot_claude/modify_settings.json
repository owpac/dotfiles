{{- /* chezmoi:modify-template */ -}}
{{- /*
  The keys that chezmoi sets in ~/.claude/settings.json. Claude Code also writes this file:
  its other keys stay. The Beads hooks come from the plugin beads@owpac.
    - env: BEADS_ACTOR is the agent name for the claims, notes and comments of bd. BEADS_DIR
      is the home workspace, also when Claude Code does not start from a shell that read
      ~/.zshenv.
    - Plugins: the marketplace owpac is the runtime clone of owpac/prompts
      (.chezmoiexternal.yaml.tmpl). Claude Code reads its plugins in place. chezmoi owns every
      plugin of owpac: it removes them, then enables the plugins of .agents.plugins
      (.chezmoidata/agents.yaml) for Claude Code and for the current mode. chezmoi does not
      manage the plugins of other marketplaces.
*/ -}}
{{- $settings := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $settings = setValueAtPath "model" "opus" $settings -}}
{{- $settings = setValueAtPath "statusLine" (dict "type" "command" "command" "bash ~/.claude/statusline-command.sh") $settings -}}
{{- $settings = setValueAtPath "env.BEADS_ACTOR" "claude" $settings -}}
{{- $settings = setValueAtPath "env.BEADS_DIR" (joinPath .chezmoi.homeDir .agents.beads_dir) $settings -}}
{{- $settings = setValueAtPath "extraKnownMarketplaces.owpac" (dict "source" (dict "source" "directory" "path" (joinPath .chezmoi.homeDir .agents.marketplaces_dir "owpac"))) $settings -}}
{{- range $id, $_ := get $settings "enabledPlugins" | default (dict) }}{{ if hasSuffix "@owpac" $id }}{{ $_ := unset $settings.enabledPlugins $id }}{{ end }}{{ end -}}
{{- range $name, $plugin := .agents.plugins }}
{{-   $plugin = $plugin | default (dict) }}
{{-   if and (has "claude" (get $plugin "agents" | default (list "claude" "codex"))) (or (not (get $plugin "work")) $.is_work) }}
{{-     $settings = setValueAtPath (printf "enabledPlugins.%s@owpac" $name) true $settings }}
{{-   end }}
{{- end }}
{{ toPrettyJson $settings }}
