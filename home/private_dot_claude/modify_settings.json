#!/bin/bash
# Merge required settings into existing settings.json without overwriting
# locally-added keys (e.g. enabledPlugins added per-device).
#
# Agent setup (see ~/.config/ia/AGENTS.md):
#   - BEADS_ACTOR=claude so bd attributes Claude's claims, notes and comments;
#   - BEADS_DIR: every task lives in the home workspace, also when Claude Code does not
#     start from a shell that read ~/.zshenv;
#   - SessionStart hook: inject Beads context (bd prime);
#   - PostToolUse hook: link the session to the Beads tasks it works on.
# Hook groups are only added when no handler with the same command exists.

current=$(cat)

if [ -z "$current" ] || [ "$current" = "{}" ]; then
  current='{}'
fi

echo "$current" | jq --arg beads_dir "$HOME/.local/share/tasks/.beads" '
  def add_hook($event; $group):
    .hooks[$event] = ((.hooks[$event] // []) as $groups
      | if any($groups[]?.hooks[]?; .command == $group.hooks[0].command)
        then $groups else $groups + [$group] end);

  .model = "opus" |
  .statusLine = {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  } |
  .env = ((.env // {}) + {"BEADS_ACTOR": "claude", "BEADS_DIR": $beads_dir}) |
  add_hook("SessionStart"; {
    "matcher": "",
    "hooks": [{"type": "command", "command": "bd prime --hook-json"}]
  }) |
  add_hook("PostToolUse"; {
    "matcher": "Bash",
    "hooks": [{
      "type": "command",
      "command": "$HOME/.config/ia/hooks/link-bd-session claude",
      "if": "Bash(bd *)"
    }]
  })
'
