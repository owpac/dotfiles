#compdef kompose

_kompose() {
    local context state state_descr line
    typeset -A opt_args

    local -a opts cmds service_cmds status_opts fix_opts

    opts=(
        '-h:Show help'
        '--help:Show help'
        '-v:Show version'
        '--version:Show version'
        '--no-color:Disable colored output'
        '--host:Host directory'
    )

    cmds=(
        'up:Start services'
        'down:Stop services'
        'restart:Restart services'
        'r:Restart services (alias)'
        'logs:View service logs'
        'l:View service logs (alias)'
        'status:Show services status with IPs'
        'st:Show services status with IPs (alias)'
        'check:Lint compose files and env drift'
        'fix:Apply fixes (compose auto-fixes + interactive env sync)'
        'service:Service lifecycle (canonical noun-verb form)'
        'svc:Service lifecycle (alias)'
    )

    service_cmds=(
        'up:Start services'
        'down:Stop services'
        'restart:Restart services'
        'r:Restart services (alias)'
        'logs:View service logs'
        'l:View service logs (alias)'
        'status:Show services status with IPs'
        'st:Show services status with IPs (alias)'
    )

    status_opts=(
        '-s:Show CPU and memory usage'
        '--stats:Show CPU and memory usage'
        '-n:Number of log lines when drilling into a service'
        '-f:Live mode (refresh table OR follow logs depending on context)'
        '--follow:Live mode (refresh table OR follow logs depending on context)'
        '-i:Refresh interval in seconds for live mode (default 2)'
        '--interval:Refresh interval in seconds for live mode (default 2)'
        '--no-logs:Suppress log tail'
    )

    fix_opts=(
        '-f:Skip confirmation'
        '--force:Skip confirmation'
        '--dry-run:Preview without applying'
        '--auto:Only compose-level auto-fixes (skip env sync)'
        '--env:Only interactive env sync (skip compose fixes)'
    )

    # Options
    if [[ ${words[CURRENT]} == -* ]]; then
        case ${words[2]} in
            status|st)
                _describe 'option' status_opts
                ;;
            fix)
                _describe 'option' fix_opts
                ;;
            *)
                _describe 'option' opts
                ;;
        esac
        return
    fi

    # First argument: command
    if (( CURRENT == 2 )); then
        _describe 'command' cmds
        return
    fi

    # Subcommands and services
    case ${words[2]} in
        service|svc)
            if (( CURRENT == 3 )); then
                _describe 'verb' service_cmds
            else
                _kompose_services
            fi
            ;;
        up|down|restart|r|logs|l|status|st|check|fix)
            _kompose_services
            ;;
    esac
}

_kompose_services() {
    local -a services
    local workspace="${WORKSPACE_DIR:-$HOME/workspace/homelab}"
    local host="${CURRENT_HOST:-nas}"

    if [[ -d "$workspace/$host" ]]; then
        services=(${(f)"$(ls -1 "$workspace/$host" 2>/dev/null | grep -v '^\.')"})
        _describe 'service' services
    fi
}

_kompose "$@"
