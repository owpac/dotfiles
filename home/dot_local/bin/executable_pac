#!/usr/bin/env bash
set -euo pipefail

_blue='\033[0;34m'
_green='\033[0;32m'
_red='\033[0;31m'
_reset='\033[0m'

log_task() { printf "${_blue}👉 %s${_reset}\n" "$*" >&2; }
log_done() { printf "${_green}✅ %s${_reset}\n" "$*" >&2; }
log_error() { printf "${_red}❌ %s${_reset}\n" "$*" >&2; }

upgrade_macos() {
    log_task "Upgrading macOS..."
    softwareupdate -ia
    log_done "macOS upgraded"
}

upgrade_apps() {
    log_task "Upgrading App Store apps..."
    mas upgrade
    log_done "App Store apps upgraded"
}

upgrade_brew() {
    log_task "Updating Homebrew..."
    brew update
    log_task "Upgrading packages..."
    # Self-updating casks (iTerm2, 1Password...) update themselves: don't let brew quit and replace them
    HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 brew upgrade
    log_task "Cleaning up..."
    brew cleanup
    log_done "Homebrew upgraded"
}

upgrade_mise() {
    log_task "Updating mise plugins..."
    mise plugins update
    log_done "Mise plugins upgraded"
}

upgrade_all() {
    local failed=0
    upgrade_macos || { log_error "macOS upgrade failed"; failed=1; }
    upgrade_apps  || { log_error "App Store upgrade failed"; failed=1; }
    upgrade_brew  || { log_error "Homebrew upgrade failed"; failed=1; }
    upgrade_mise  || { log_error "Mise upgrade failed"; failed=1; }
    return $failed
}

# --- macOS app preference snapshots (~/.config/macos-preferences/) -----------------
preferences_dir="$HOME/.config/macos-preferences"

_preferences_domains() {
    local f b
    for f in "$preferences_dir"/*.plist; do
        [[ -e "$f" ]] || continue
        b="$(basename "$f" .plist)"
        # keep only well-formed reverse-DNS domains (skip stray/misnamed files)
        [[ "$b" == *.* && "$b" != *.plist ]] && printf '%s\n' "$b"
    done
}

# slug = last dot-component, lowercased (com.apple.Terminal -> terminal)
_slug_for() { printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]'; }

# resolve a slug OR a full domain to a domain name
_domain_for() {
    local arg="$1" d
    arg="${arg%.plist}"                  # tolerate a trailing .plist (com.apple.Safari.plist)
    if [[ "$arg" == *.* ]]; then
        [[ "$arg" == */* ]] && return 1  # reject path-like args
        printf '%s' "$arg"; return 0
    fi
    while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        [[ "$(_slug_for "$d")" == "$arg" ]] && { printf '%s' "$d"; return 0; }
    done < <(_preferences_domains)
    return 1
}

_data_file() { printf '%s/.chezmoidata.yaml' "$(chezmoi source-path)"; }

# Ensure a domain is listed under macos_preferences_domains in .chezmoidata.yaml
# (the import script only re-applies domains from that list).
_ensure_in_data() {
    local domain="$1" data="$2" tmp
    grep -q '^macos_preferences_domains:' "$data" || {
        log_error "No 'macos_preferences_domains:' key in $data — add '$domain' by hand"
        return 1
    }
    grep -qxF "  - $domain" "$data" && return 0   # already listed
    tmp="$(mktemp)"
    awk -v item="  - $domain" '
        function flush() { if (inblock && !added) { print item; added=1 } }
        /^[^[:space:]#]/ { flush(); inblock = ($0 == "macos_preferences_domains:") ? 1 : 0 }
        { print }
        END { flush() }
    ' "$data" > "$tmp" && mv "$tmp" "$data"
    log_task "Added '$domain' to .chezmoidata.yaml (macos_preferences_domains)"
}

preferences_save() {
    mkdir -p "$preferences_dir"
    local domains=() arg d out data
    data="$(_data_file)"
    if (( $# == 0 )); then
        while IFS= read -r d; do [[ -n "$d" ]] && domains+=("$d"); done < <(_preferences_domains)
    else
        for arg in "$@"; do
            d="$(_domain_for "$arg")" || { log_error "Unknown preference '$arg' (not a saved slug or a domain)"; return 1; }
            domains+=("$d")
        done
    fi
    if (( ${#domains[@]} == 0 )); then
        log_error "Nothing to save — no snapshots in $preferences_dir"
        return 1
    fi
    for d in "${domains[@]}"; do
        if ! defaults read "$d" >/dev/null 2>&1; then
            log_error "Skipping '$d' (no such defaults domain)"
            continue
        fi
        out="$preferences_dir/$d.plist"
        defaults export "$d" "$out"
        if chezmoi managed | grep -qx ".config/macos-preferences/$d.plist"; then
            chezmoi re-add "$out"          # no-op if nothing changed
        else
            chezmoi add --encrypt "$out"
        fi
        _ensure_in_data "$d" "$data"
        log_done "Saved $d ($(_slug_for "$d"))"
    done
    log_task "Review and commit: chezmoi cd  ->  git add -p && git commit"
}

preferences_remove() {
    (( $# )) || { log_error "Usage: pac preferences remove <name>..."; return 1; }
    local data arg d target src tmp
    data="$(_data_file)"
    for arg in "$@"; do
        d="$(_domain_for "$arg")" || { log_error "Unknown preference '$arg'"; return 1; }
        target="$preferences_dir/$d.plist"
        # 1. drop from the tracked list
        if grep -qxF "  - $d" "$data"; then
            tmp="$(mktemp)"; grep -vxF "  - $d" "$data" > "$tmp" && mv "$tmp" "$data"
        fi
        # 2. stop tracking the encrypted snapshot in the chezmoi source
        if chezmoi managed | grep -qx ".config/macos-preferences/$d.plist"; then
            src="$(chezmoi source-path "$target" 2>/dev/null)"
            [[ -n "$src" && -f "$src" ]] && rm -f "$src"
        fi
        # 3. drop the local snapshot mirror (the app's live prefs stay untouched)
        rm -f "$target"
        log_done "Removed $d ($(_slug_for "$d")) — live app prefs untouched"
    done
    log_task "Review and commit: chezmoi cd  ->  git add -p && git commit"
}

preferences_list() {
    local d found=0
    printf "%-12s %s\n" "SLUG" "DOMAIN"
    while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        found=1
        printf "%-12s %s\n" "$(_slug_for "$d")" "$d"
    done < <(_preferences_domains)
    (( found )) || log_error "No preferences saved yet in $preferences_dir"
}

# --- AI agents: Beads tasks <-> Claude/Codex sessions (see ~/.config/ia/AGENTS.md) --------
# Sessions are linked to tasks by the hook ~/.config/ia/hooks/link-bd-session
# ("transcript" provenance, task metadata sessions.<tool>).
# Every task lives in the home workspace. BEADS_DIR points to it (~/.zshenv, Claude Code
# and Codex settings), and bd uses BEADS_DIR before any workspace of the current repository.

_agent_home_dir="$HOME/.local/share/tasks"
_agent_home_beads="$_agent_home_dir/.beads"
export BEADS_DIR=${BEADS_DIR:-$_agent_home_beads}

# Explicit Claude launch options: the org-managed "opusplan" model runs Sonnet outside plan
# mode (auto mode included), and flags win over every settings file, managed ones too.
# ANTHROPIC_MODEL from the dotfiles is honored when set.
_agent_claude_opts=(--model "${ANTHROPIC_MODEL:-opus[1m]}" --permission-mode auto)

_agent_codex_bin() {
    command -v codex || ls -d "$HOME"/.vscode/extensions/openai.chatgpt-*/bin/*/codex 2>/dev/null | tail -1
}

_agent_require_task() {
    bd show "$1" --json >/dev/null 2>&1 && return
    log_error "Task $1 not found in the Beads workspace ($BEADS_DIR)"
    exit 1
}

# Home workspace: a dedicated directory, because bd init outside a git repository runs
# git init in the current directory (not in ~), and refuses any path under a .beads one.
agent_init() {
    local dry=0
    while [[ $# -gt 0 ]]; do
        case $1 in
            --dry-run) dry=1; shift ;;
            *) log_error "Unknown option: $1"; usage; exit 1 ;;
        esac
    done
    if [[ -f $_agent_home_beads/metadata.json ]]; then
        log_done "The home workspace already exists ($_agent_home_dir)"
        return
    fi
    if [[ -d $HOME/.beads/shared-server/dolt/tasks ]]; then
        log_error "A \"tasks\" database already exists on the shared server, without its workspace in $_agent_home_dir"
        exit 1
    fi
    log_task "Creating the home workspace in $_agent_home_dir (database \"tasks\", prefix \"task\", shared Dolt server)..."
    if ((dry)); then
        log_done "Dry run: nothing was changed"
        return
    fi
    mkdir -p "$_agent_home_dir"
    # With BEADS_DIR set, bd init creates the database but no metadata.json.
    (cd "$_agent_home_dir" && env -u BEADS_DIR bd init --shared-server --skip-agents --non-interactive -q -p task --database tasks >/dev/null)
    log_done "Home workspace created. bd reaches it from any directory through BEADS_DIR (~/.zshenv)"
}

# Sessions linked to a task (JSON array, oldest first).
_agent_sessions() {
    bd provenance log "$1" --json 2>/dev/null |
        jq -c '[.[]? | select(.ref_kind == "transcript" and (.ref | test("^(claude|codex):")))] | sort_by(.created_at)'
}

agent_task() {
    local id=$1 s n
    _agent_require_task "$id"
    bd show "$id" --json | jq -r '.[0] // . | "\(.id) · \(.title) [\(.status)]"'
    s=$(_agent_sessions "$id")
    n=$(jq length <<<"$s")
    if ((n == 0)); then
        echo "  No linked session. Start one: pac agent new $id [claude|codex]"
    else
        jq -r 'to_entries[] | .value as $v | ($v.payload | fromjson? // {}) as $p
          | "  \(.key + 1). \($v.created_at[0:16] | sub("T"; " "))  \($v.actor)  \($v.ref)\(if $p.cwd then "  (" + $p.cwd + ")" else "" end)"' <<<"$s"
        echo "  Resume: pac agent resume $id [n]   ·   New: pac agent new $id [claude|codex]"
    fi
    # Engram memories citing the task (the convention makes every memory cite its Beads id).
    # All projects: the memories of a task belong to the project of each session.
    if command -v engram >/dev/null; then
        engram search "$id" --all --limit 5 2>/dev/null | grep -E '^\[[0-9]+\] #' | sed 's/^/  Memory: /' || true
    fi
}

agent_resume() {
    local id=$1 n=${2:-0} s count e ref tool sid cwd
    _agent_require_task "$id"
    s=$(_agent_sessions "$id")
    count=$(jq length <<<"$s")
    if ((count == 0)); then
        log_error "No session linked to $id. Start one: pac agent new $id"
        exit 1
    fi
    if ((n == 0)); then n=$count; fi
    if ((n < 1 || n > count)); then
        log_error "No session $n (1 to $count)"
        exit 1
    fi
    e=$(jq -c ".[$((n - 1))]" <<<"$s")
    ref=$(jq -r .ref <<<"$e")
    tool=${ref%%:*}
    sid=${ref#*:}
    cwd=$(jq -r '.payload | fromjson? | .cwd // empty' <<<"$e")
    # The original worktree may have been removed: fall back to the repository root.
    if [[ -z $cwd || ! -d $cwd ]]; then cwd=$(git rev-parse --show-toplevel 2>/dev/null || pwd); fi
    cd "$cwd"
    log_task "Resuming $tool session $sid in $cwd"
    case $tool in
        claude) exec claude "${_agent_claude_opts[@]}" --resume "$sid" ;;
        codex) exec "$(_agent_codex_bin)" resume "$sid" ;;
    esac
}

agent_new() {
    local id=$1 tool=${2:-claude} root previous prompt sid current
    _agent_require_task "$id"
    root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    cd "$root"

    # Earlier sessions, so the new one knows they exist (raw transcripts only as a last resort).
    previous=$(_agent_sessions "$id" | jq -r '.[] | (.payload | fromjson? // {}) as $p
      | "- \(.ref) (\(.created_at[0:10]))\(if ($p.transcript_path // "") != "" then ", transcript: " + $p.transcript_path else "" end)"')

    prompt="Work on Beads task $id.
Before anything else, recover the context left by earlier work on this task:
1. run 'bd show $id' and read its description, notes and comments;
2. search engram memory for '$id' (mem_search): earlier sessions saved their decisions and findings there.
Claim the task with 'bd update $id --claim' if it is not already yours, then follow the \"Tasks and memory\" section of your instructions."
    if [[ -n $previous ]]; then
        prompt+="
Earlier sessions on this task (read a raw transcript only if memory and notes are not enough):
$previous"
    fi

    case $tool in
        claude)
            # Claude accepts a caller-chosen session id: the task is linked before the session starts.
            sid=$(uuidgen | tr '[:upper:]' '[:lower:]')
            bd provenance record --issue "$id" --kind used --source claude-hook --actor claude \
                --ref "claude:$sid" --ref-kind transcript --payload "$(jq -nc --arg cwd "$root" '{cwd: $cwd}')" -q >/dev/null
            current=$(bd show "$id" --json | jq -r '(.[0] // .).metadata["sessions.claude"] // empty')
            current=${current// /} # normalized "id1,id2" (older values had no space)
            current=${current:+$current,}$sid
            bd update "$id" --set-metadata "sessions.claude=${current//,/, }" -q >/dev/null
            exec claude "${_agent_claude_opts[@]}" --session-id "$sid" "$prompt"
            ;;
        codex)
            # Codex cannot take a chosen session id: the hook links it on its first bd write on the task.
            exec "$(_agent_codex_bin)" "$prompt"
            ;;
        *) log_error "Unknown tool: $tool (claude or codex)"; exit 1 ;;
    esac
}

usage() {
    cat >&2 <<EOF
Usage: pac <command> [args]

Commands:
    upgrade                     Upgrade everything (macOS, apps, brew, mise)
    upgrade macos|apps|brew|mise
    preferences list            List saved macOS app preferences (slug -> domain)
    preferences save [name...]  Snapshot app preferences — all tracked, or by slug/domain
                                (e.g. 'pac preferences save terminal')
    preferences remove <name>   Stop tracking an app's preferences (keeps live prefs)
    agent init [--dry-run]      Create the Beads home workspace, which holds every task
                                (~/.local/share/tasks, ids task-…; chezmoi apply creates it)
    agent task <id>             List the agent sessions linked to a Beads task
    agent resume <id> [n]       Resume a linked session (default: the most recent)
    agent new <id> [claude|codex]
                                Start a session that recovers the task's context
EOF
}

case "${1:-}" in
    upgrade)
        case "${2:-}" in
            "")    upgrade_all ;;
            macos) upgrade_macos ;;
            apps)  upgrade_apps ;;
            brew)  upgrade_brew ;;
            mise)  upgrade_mise ;;
            *)     usage; exit 1 ;;
        esac
        ;;
    preferences)
        case "${2:-}" in
            ""|list) preferences_list ;;
            save)    shift 2; preferences_save "$@" ;;
            remove)  shift 2; preferences_remove "$@" ;;
            *)       usage; exit 1 ;;
        esac
        ;;
    agent)
        case "${2:-}" in
            init)   shift 2; agent_init "$@" ;;
            task)   [[ $# -ge 3 ]] || { usage; exit 1; }; agent_task "$3" ;;
            resume) [[ $# -ge 3 ]] || { usage; exit 1; }; shift 2; agent_resume "$@" ;;
            new)    [[ $# -ge 3 ]] || { usage; exit 1; }; shift 2; agent_new "$@" ;;
            *)      usage; exit 1 ;;
        esac
        ;;
    *)  usage ;;
esac
