#!/usr/bin/env bash
# wt prune-merged: remove the worktree of each pull request that GitHub merged.
#
# wt runs this script as a custom subcommand: a program wt-<name> on the PATH gives wt <name>.
# The post-start hook of ~/.config/worktrunk/config.toml runs it after each new worktree.
#
# The script removes the worktree of a branch only if GitHub merged a pull request of this
# branch, and if one of these conditions is true:
# - The last commit of the pull request is the local commit of the branch.
# - The pull request contains the local commit, and the default branch does not. This case
#   covers the button "Update branch" of GitHub: it adds a commit that the local branch does
#   not have.
# A new worktree has no merged pull request, or a different commit, so the script keeps it.
# The script also keeps the main worktree, the current worktree, a detached worktree and a
# locked worktree. wt remove keeps a worktree with uncommitted changes.
# If git or gh fails, the script removes nothing more and exits with 0, so a hook never fails.
#
# Usage: wt prune-merged [--dry-run]

set -uo pipefail

dry_run=false
if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=true
fi

log() {
  printf 'wt prune-merged: %s\n' "$*" >&2
}

current_worktree=$(git rev-parse --show-toplevel 2>/dev/null) || {
  log "not in a git repository"
  exit 0
}

# gh reads the pull requests of the GitHub repository of origin: owner/name.
origin_url=$(git remote get-url origin 2>/dev/null) || {
  log "no remote origin"
  exit 0
}
repository=$(sed -E -e 's#^(git@|ssh://git@|https://)github\.com[:/]##' -e 's#\.git$##' <<<"$origin_url")
if [[ "$repository" == "$origin_url" ]]; then
  log "origin is not on GitHub"
  exit 0
fi

if ! git fetch --prune --quiet origin; then
  log "git fetch failed: no removal"
  exit 0
fi

# The default branch of origin, for example origin/main. If it is not known, the script uses
# only the first condition.
default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) || default_branch=""

# Succeeds if a merged pull request contains the local commit (see the conditions above).
# $1: the local commit. $2: the last commit of each merged pull request, one per line.
is_merged() {
  local local_head=$1 merged_heads=$2 head status
  if grep -qx "$local_head" <<<"$merged_heads"; then
    return 0
  fi
  # A local commit in the default branch is not work of the branch: a new worktree starts there.
  if [[ -z "$default_branch" ]] || git merge-base --is-ancestor "$local_head" "$default_branch"; then
    return 1
  fi
  while IFS= read -r head; do
    # GitHub compares base...head. "ahead" tells that the head contains the base. If GitHub does
    # not know the local commit (not pushed), the call fails and the script keeps the worktree.
    status=$(gh api "repos/$repository/compare/$local_head...$head" --jq .status 2>/dev/null) || continue
    if [[ "$status" == "ahead" ]]; then
      return 0
    fi
  done <<<"$merged_heads"
  return 1
}

# git worktree list --porcelain gives one block for each worktree, the main worktree first.
# A block has the lines "worktree <path>", "branch refs/heads/<name>", and optionally
# "detached", "locked" or "prunable". An empty line ends a block.
branches=()
is_main=true
path="" branch="" keep=false
while IFS= read -r line; do
  case "$line" in
    "worktree "*) path=${line#worktree } ;;
    "branch refs/heads/"*) branch=${line#branch refs/heads/} ;;
    detached | "locked"* | "prunable"*) keep=true ;;
    "")
      if [[ -n "$path" ]]; then
        if ! $is_main && ! $keep && [[ -n "$branch" && "$path" != "$current_worktree" ]]; then
          branches+=("$branch")
        fi
        is_main=false
      fi
      path="" branch="" keep=false
      ;;
  esac
done < <(git worktree list --porcelain; echo)

# The expansion with + works with an empty array in bash 3.2, the bash of macOS.
for branch in ${branches[@]+"${branches[@]}"}; do
  # gh pr list gives an empty list if the branch has no merged pull request, and fails only
  # if GitHub does not answer.
  if ! merged_heads=$(gh pr list --repo "$repository" --head "$branch" --state merged \
    --json headRefOid --jq '.[].headRefOid'); then
    log "gh failed: no removal"
    exit 0
  fi
  if [[ -z "$merged_heads" ]]; then
    continue
  fi
  local_head=$(git rev-parse --verify --quiet "refs/heads/$branch") || continue
  if ! is_merged "$local_head" "$merged_heads"; then
    continue
  fi
  if $dry_run; then
    log "would remove the worktree of $branch"
  elif ! wt remove --foreground "$branch"; then
    log "wt remove refused the worktree of $branch"
  fi
done

exit 0
