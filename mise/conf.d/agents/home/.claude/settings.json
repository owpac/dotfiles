{#- The keys that mise sets in ~/.claude/settings.json (merge entry of mise.agents.toml).
  Claude Code also writes this file: its other keys stay. The Beads hooks come from the plugin
  beads@owpac.
    - env: BEADS_ACTOR is the agent name for the claims, notes and comments of bd. BEADS_DIR is
      the home workspace, also when Claude Code does not start from a shell that read ~/.zshenv.
    - permissions.defaultMode: each session starts in auto mode. `--permission-mode` or
      shift+tab changes the mode of one session.
    - Plugins: Claude Code clones each marketplace itself, at the start of a session, and
      installs the plugins that this file enables. With autoUpdate, an interactive session
      updates the marketplaces and their plugins.
    - owpac: the private repository owpac/prompts. Git clones it over SSH, with the 1Password
      agent of ~/.ssh/config. If 1Password is locked, the update fails without a message, and
      the old version stays.
    - mise enables the plugins of vars.agent_plugins, and of vars.agent_plugins_work in the work
      mode. A merge entry does not remove a key: to remove a plugin, set it to false here, or
      remove it with /plugin.
    - worktrunk@worktrunk: the plugin of wt, from its GitHub repository. -#}
{%- set plugins = vars.agent_plugins | split(pat=" ") -%}
{%- if "work" in (mise_env | default(value=[])) and vars.agent_plugins_work -%}
{%- set plugins = [...plugins, ...(vars.agent_plugins_work | split(pat=" "))] -%}
{%- endif -%}
{
  "model": "opus",
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "env": {
    "BEADS_ACTOR": "claude",
    "BEADS_DIR": "{{ env.HOME }}/{{ vars.beads_dir }}"
  },
  "extraKnownMarketplaces": {
    "owpac": {
      "source": {
        "source": "git",
        "url": "git@github.com:owpac/prompts.git"
      },
      "autoUpdate": true
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
{%- for plugin in plugins %}
    "{{ plugin }}@owpac": true,
{%- endfor %}
    "worktrunk@worktrunk": true
  }
}
