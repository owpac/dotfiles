{#- The keys that mise sets in ~/.claude/settings.json (merge entry of mise.agents.toml).
  Claude Code also writes this file: its other keys stay. The Beads hooks come from the plugin
  beads@owpac.
    - env: BEADS_ACTOR is the agent name for the claims, notes and comments of bd. BEADS_DIR is
      the home workspace, also when Claude Code does not start from a shell that read ~/.zshenv.
    - permissions.defaultMode: each session starts in auto mode. `--permission-mode` or
      shift+tab changes the mode of one session.
    - Plugins: Claude Code clones each marketplace itself, at the start of a session, and
      installs the plugins that this file enables. With autoUpdate, an interactive session
      updates the marketplaces and their plugins, after a random delay of up to 10 minutes. The
      task agent-plugins (mise run agent-plugins, and each mise bootstrap) updates them at once.
    - owpac: the private repository owpac/prompts. Git clones it over SSH, with the 1Password
      agent of ~/.ssh/config. If 1Password is locked, the update fails without a message, and
      the old version stays.
    - mise enables the plugins of vars.agent_plugins (<plugin>@<marketplace>), and of
      vars.agent_plugins_work in the work mode. A merge entry does not remove a key: the task
      agent-plugins uninstalls each plugin of a marketplace of these vars that these vars do not
      give, and removes its key.
    - worktrunk: the marketplace of wt, from its GitHub repository.
    - attribution: no Co-Authored-By trailer in commits, and no footer in pull requests.
      Without this key, Claude Code tells each session to add them, and a small model
      (Haiku) can follow this order instead of CLAUDE.md.
    - autoMemoryEnabled: no auto memory (~/.claude/projects/<project>/memory/). engram keeps
      the durable memory of the agents (AGENTS.md, section "Memory: engram").
    - permissions.deny: the commands that AGENTS.md and PRIME.md forbid. A deny rule blocks in
      each permission mode, also in a compound command and after an env var prefix. It does
      not block `sh -c '...'` or the full path of the program. mise replaces the array of
      the target with this array: add a deny rule here, not with /permissions. -#}
{%- set plugins = vars.agent_plugins | split(pat=" ") -%}
{%- if "work" in (mise_env | default(value=[])) and vars.agent_plugins_work -%}
{%- set plugins = [...plugins, ...(vars.agent_plugins_work | split(pat=" "))] -%}
{%- endif -%}
{
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(bd init *)",
      "Bash(bd setup *)",
      "Bash(wt step prune *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "env": {
    "BEADS_ACTOR": "claude",
    "BEADS_DIR": "{{ env.HOME }}/{{ vars.beads_dir }}"
  },
  "extraKnownMarketplaces": {
    "owpac": {
      "source": {
        "source": "git",
        "url": "git@github.com:owpac/prompts.git"
      },
      "autoUpdate": true
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
{%- for plugin in plugins %}
    "{{ plugin }}": true{% if not loop.last %},{% endif %}
{%- endfor %}
  }
}
