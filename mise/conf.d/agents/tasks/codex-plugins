#!/usr/bin/env bash
#MISE description="Clone the git marketplaces of Codex and install the plugins of owpac"
#
# Codex clones its git marketplaces (owpac, worktrunk) at the start of a session. Before the first
# session, the task clones them. If ~/.codex/config.toml enables a new plugin, Codex installs it
# only after a change of its marketplace. So the task also installs the plugins of owpac that
# config.toml enables, and removes the copies of the other plugins of owpac. Claude Code clones
# and installs its plugins itself, so it needs no task.
# mise bootstrap runs this task each time (task bootstrap). The task is idempotent, and does
# nothing without Codex.

set -eufo pipefail

# lib/ is at the root of this repository: follow the link of this task to find it.
source "$(dirname "$(readlink -f "$0")")/../../../../lib/logs.sh"

command -v codex >/dev/null 2>&1 || exit 0

# config.toml declares the git marketplaces (owpac, worktrunk), but mise does not clone them.
# Codex clones a git marketplace at the start of a session, or with `codex plugin marketplace add`
# or `upgrade`. Without the clone, `codex plugin list` fails, and `pac upgrade agents` stops. If
# the clone of a marketplace is missing, `codex plugin marketplace list` fails: the task then
# clones it.
if ! codex plugin marketplace list >/dev/null 2>&1; then
  log_task "Cloning the git marketplaces of Codex..."
  if codex plugin marketplace upgrade >/dev/null; then
    log_done "Codex git marketplaces cloned"
  else
    log_error "Could not clone the git marketplaces of Codex"
  fi
fi

# Codex reads config.toml itself. For each plugin of owpac, the list gives enabled (config.toml
# enables the plugin) and installed (the cache has a copy). --available adds the plugins without a
# copy.
if ! plugins=$(codex plugin list --json --available --marketplace owpac); then
  log_error "Could not list the plugins of owpac in Codex"
  exit 0
fi

# Print the id of each plugin of owpac whose state matches a jq condition.
plugins_where() {
  jq -r "(.installed + .available)[] | select($1) | .pluginId" <<<"$plugins"
}

for id in $(plugins_where '.enabled and (.installed | not)'); do
  log_task "Installing Codex plugin $id..."
  codex plugin add "$id" >/dev/null || log_error "Could not install $id in Codex"
done

for id in $(plugins_where '.installed and (.enabled | not)'); do
  log_task "Removing Codex plugin $id, which config.toml no longer enables..."
  codex plugin remove "$id" >/dev/null || log_error "Could not remove $id from Codex"
done
